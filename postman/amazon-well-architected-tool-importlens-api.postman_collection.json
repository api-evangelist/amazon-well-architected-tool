  "item": [
    {
      "name": "importLens",
      "item": [
        {
          "name": "Amazon Well-Architected Tool Import Lens",
          "id": "c1d98d89-4213-4ec9-87a6-9424e0372ae8",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Amz-Content-Sha256",
                "value": "<string>"
              },
              {
